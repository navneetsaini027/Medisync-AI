# Server
HOST="localhost"
PORT="3001"
CORS_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# Groq API key used only by the backend.
GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_REQUEST_TIMEOUT_MS="600000"
ANALYSIS_TIMEOUT_MS="900000"

# Optional API rate limits for report endpoints.
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="120"
